digraph BLOCK {
  graph [rankdir=TB, fontname="Liberation Serif", dpi=170, nodesep=0.22, ranksep=0.35, pad=0.2, compound=true];
  node [fontname="Liberation Serif", fontsize=16, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#1f6b49", width=2.3, height=0.7];
  edge [color="#333333", arrowsize=0.8, penwidth=1.3];
  subgraph cluster_in { label="INPUT LAYER"; fontname="Liberation Serif Bold"; fontsize=17; style="rounded,filled"; fillcolor="#f3f7f4"; color="#7a8a80";
    I1 [label="Satellite indices\n(NDVI, LAI)"]; I2 [label="Soil moisture,\npH, organic carbon"]; I3 [label="Rainfall, temperature,\nhumidity"];
    I4 [label="Plot polygons,\ntaluk, village"]; I5 [label="Weather scenario /\nforecast rain"]; I6 [label="Crop age\n(STEPS / estimate)"];
    {rank=same; I1 I2 I3} {rank=same; I4 I5 I6} I1 -> I4 [style=invis]; I2 -> I5 [style=invis]; I3 -> I6 [style=invis]; }
  subgraph cluster_pre { label="PRE-PROCESSING & FEATURE ENGINEERING"; fontname="Liberation Serif Bold"; fontsize=17; style="rounded,filled"; fillcolor="#f3f7f4"; color="#7a8a80";
    P1 [label="Missing-value imputation\n(village median)"]; P2 [label="Outlier / sensor flags\n(robust z-score)"]; P3 [label="Scenario features +\nsoil-moisture depletion"];
    {rank=same; P1 P2 P3} }
  subgraph cluster_ml { label="MACHINE-LEARNING MODELS (tree ensembles, JSON inference in Node.js)"; fontname="Liberation Serif Bold"; fontsize=17; style="rounded,filled"; fillcolor="#e6f3ea"; color="#1f6b49";
    M1 [label="RF: next irrigation"]; M2 [label="GBM: crop water req."]; M3 [label="GBM: irrigation depth"]; M4 [label="RF: water stress"];
    M5 [label="GBM: cane yield"]; M6 [label="GBM: yield loss (delay)"]; M7 [label="RF: disease risk"]; M8 [label="K-Means: zones"];
    {rank=same; M1 M2 M3 M4} {rank=same; M5 M6 M7 M8}
    M1 -> M5 [style=invis]; M2 -> M6 [style=invis]; M3 -> M7 [style=invis]; M4 -> M8 [style=invis]; }
  subgraph cluster_dec { label="DECISION-SUPPORT ENGINE"; fontname="Liberation Serif Bold"; fontsize=17; style="rounded,filled"; fillcolor="#f3f7f4"; color="#7a8a80";
    D1 [label="Rain-adjusted\nirrigation status"]; D2 [label="Hydraulics: volume,\npump hours"]; D3 [label="Fertigation\nplanner"]; D4 [label="WSPT pump\nscheduler"]; D5 [label="Explainability\n(sensitivity)"];
    {rank=same; D1 D2 D3} {rank=same; D4 D5} D1 -> D4 [style=invis]; D2 -> D5 [style=invis]; }
  subgraph cluster_out { label="OUTPUT & DISSEMINATION LAYER"; fontname="Liberation Serif Bold"; fontsize=17; style="rounded,filled"; fillcolor="#f3f7f4"; color="#7a8a80";
    O1 [label="Web dashboard\n& farm map"]; O2 [label="Plot advisory\n(EN / KN / HI / MR)"]; O3 [label="Krishi Mitra\nchatbot"]; O4 [label="Pump timetable\n(Gantt)"]; O5 [label="REST API\n(STEPS / mobile)"];
    {rank=same; O1 O2 O3} {rank=same; O4 O5} O1 -> O4 [style=invis]; O2 -> O5 [style=invis]; }
  I5 -> P2 [ltail=cluster_in, lhead=cluster_pre];
  P2 -> M2 [ltail=cluster_pre, lhead=cluster_ml];
  M6 -> D2 [ltail=cluster_ml, lhead=cluster_dec];
  D5 -> O2 [ltail=cluster_dec, lhead=cluster_out];
}
